	cd /home/friedrichc/Placement/build_clean && $(MAKE) $(MAKESILENT) -f test/CMakeFiles/test_wirelength.dir/build.make test/CMakeFiles/test_wirelength.dir/test_wirelength.cpp.s
.PHONY : test_wirelength.cpp.s

